{
  "app": {
    // 签名材料不入库：入库版签名段清空（本地真实签名配置自行配置或恢复备份）
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "compileSdkVersion": 23,
        "targetSdkVersion": "23",
        "compatibleSdkVersion": 23,
        "runtimeOS": "OpenHarmony",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug",
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "dreamEmberGeoCalc",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}